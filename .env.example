# Environment: research | paper | live
ENV=research

# Database (defaults to data/market_${ENV}.db if not set)
# DB_PATH=data/market_research.db

# Base currency for reporting; instrument native currencies are stored per row
REPORTING_CURRENCY=IDR

# Logging
LOG_LEVEL=INFO

# GPU selection for ML tasks (cuda:1 per project rules; fallback to cpu)
# Windows tanpa CUDA: set DEVICE=cpu
DEVICE=cuda:1

# Market data sources
YFINANCE_ENABLED=true
YFINANCE_RATE_LIMIT_PER_SECOND=1
IDX_SCRAPER_ENABLED=true

# Parquet archive path (OS-aware default via market.paths jika tidak diset)
# Linux:   /media/petrick/Parquet/pustaka_data
# Windows: E:/pustaka_data
# PARQUET_ARCHIVE_PATH=

# Broker adapter (mock | paper | sinarmas | bni | interactive_brokers | alpaca)
# For live trading, set LIVE_APPROVAL_TOKEN and ensure ENV=live.
BROKER_ADAPTER=mock

# Live trading approval (file path containing signed approval token)
LIVE_APPROVAL_TOKEN=

# Notifications
# ── Telegram Bot Setup (untuk daily_signal_cron.py) ──────────────────
# 1. Buka Telegram, cari @BotFather → /newbot → ikuti prompt
# 2. Salin Bot Token (format: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
# 3. Buat channel atau group, tambahkan bot sebagai admin
# 4. Dapatkan Chat ID: kirim pesan ke bot, lalu akses:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → lihat "chat":{"id":...}
#    Untuk channel: Chat ID diawali -100 (mis. -1001234567890)
# 5. Set di .env:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Modal portofolio untuk position sizing (default: 100000000 = 100jt IDR)
PORTFOLIO_CAPITAL=100000000
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Third-party API keys (never commit real values)
RAPIDAPI_KEY=
ITICK_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

# Risk defaults
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_DRAWDOWN_PCT=10.0
DEFAULT_POSITION_SIZE_PCT=5.0

# Paths
DATA_DIR=data
LOG_DIR=logs
MODEL_DIR=models
CACHE_DIR=.cache

# ── External Data Drive ─────────────────────────────────────────────
# Backup/restore path untuk data besar (DB 6GB, CSV 233MB).
# Data ini TIDAK ada di Git — wajib restore dari external drive atau seed dari Parquet.
# Skrip: scripts/sync_data_to_external.sh (backup) | scripts/restore_data_from_external.sh (restore)
# OS-aware default via market.paths jika tidak diset:
#   Linux:   /media/petrick/Parquet/projects/market
#   Windows: E:/projects/market
# EXTERNAL_DATA_PATH=

# Parquet seed source (untuk seed_from_parquet.py)
# OS-aware default via market.paths jika tidak diset:
#   Linux:   /media/petrick/Parquet/pustaka_data/archive/tables
#   Windows: E:/pustaka_data/archive/tables
# PARQUET_SEED_PATH=

# Dataset-Saham-IDX (GitHub clone, 233 MB CSV)
# Clone: git clone https://github.com/wildangunawan/Dataset-Saham-IDX.git data/dataset-saham-idx
DATASET_SAHAM_IDX_PATH=data/dataset-saham-idx
