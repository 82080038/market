# Environment: research | paper | live
ENV=research

# Database (defaults to data/market_${ENV}.db if not set)
# DB_PATH=data/market_research.db

# Base currency for reporting; instrument native currencies are stored per row
REPORTING_CURRENCY=IDR

# Logging
LOG_LEVEL=INFO

# GPU selection for ML tasks (cuda:1 per project rules; fallback to cpu)
DEVICE=cuda:1

# Market data sources
YFINANCE_ENABLED=true
YFINANCE_RATE_LIMIT_PER_SECOND=1
IDX_SCRAPER_ENABLED=true
PARQUET_ARCHIVE_PATH=/media/petrick/Parquet/pustaka_data

# Broker adapter (mock | paper | sinarmas | bni | interactive_brokers | alpaca)
# For live trading, set LIVE_APPROVAL_TOKEN and ensure ENV=live.
BROKER_ADAPTER=mock

# Live trading approval (file path containing signed approval token)
LIVE_APPROVAL_TOKEN=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Third-party API keys (never commit real values)
RAPIDAPI_KEY=
ITICK_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

# Risk defaults
DEFAULT_DAILY_LOSS_LIMIT_PCT=2.0
DEFAULT_MAX_DRAWDOWN_PCT=10.0
DEFAULT_POSITION_SIZE_PCT=5.0

# Paths
DATA_DIR=data
LOG_DIR=logs
MODEL_DIR=models
CACHE_DIR=.cache

# ── External Data Drive ─────────────────────────────────────────────
# Backup/restore path untuk data besar (DB 6GB, CSV 233MB).
# Data ini TIDAK ada di Git — wajib restore dari external drive atau seed dari Parquet.
# Skrip: scripts/sync_data_to_external.sh (backup) | scripts/restore_data_from_external.sh (restore)
EXTERNAL_DATA_PATH=/media/petrick/Parquet/projects/market

# Parquet seed source (untuk seed_from_parquet.py)
# Ubah path ini sesuai lokasi Parquet archive Anda
PARQUET_SEED_PATH=/media/petrick/Parquet/pustaka_data/archive/tables

# Dataset-Saham-IDX (GitHub clone, 233 MB CSV)
# Clone: git clone https://github.com/wildangunawan/Dataset-Saham-IDX.git data/dataset-saham-idx
DATASET_SAHAM_IDX_PATH=data/dataset-saham-idx
